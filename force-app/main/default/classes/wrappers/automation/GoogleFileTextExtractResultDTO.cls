/**
 * The text read out of a file, with enough around it to tell a short document from a long one that was
 * cut.
 */
public class GoogleFileTextExtractResultDTO {
	public Id googleFileVersionId;
	public String fileName;
	public String text;
	public Integer characterCount;
	/**
	 * True when the text stops at the requested maximum rather than at the end of the document.
	 */
	public Boolean isTruncated = false;
}
